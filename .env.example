# Telegram API credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Default 2FA password to set on new sessions
DEFAULT_2FA_PASSWORD=YourStrong2FAPassword!

# Redis connection
REDIS_URL=redis://localhost:6379/0

# SQLite database path
DB_PATH=./data/sessions.db

# Session files directory
SESSIONS_DIR=./data/sessions

# Webhook URL for forwarding messages (optional)
WEBHOOK_URL=

# Centralized bot token for forwarding (optional)
FORWARD_BOT_TOKEN=
FORWARD_CHAT_ID=

# Server settings
HOST=0.0.0.0
PORT=8000
